# ─── Database (Hostinger MySQL) ─────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:3306/DATABASE
# Hostinger hPanel > Databases > MySQL Databases se milega.
DATABASE_URL="mysql://u123456789_pkee:YourStrongPassword@srv1234.hstgr.io:3306/u123456789_pkestore"
# Hostinger remote MySQL SSL ke liye "true" rakhen (agar connect na ho to "false" try karen)
DATABASE_SSL="false"

# ─── Security ──────────────────────────────────────────────
# Kam az kam 32 characters ka random string. Generate: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Master admin sirf ek dafa banane ke liye secret key (/admin/setup page pe puchi jaye gi)
SETUP_KEY="change-me-setup-key"

# ─── Site ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://pkestore.com"

# ─── Image uploads ─────────────────────────────────────────
# Vercel pe: Vercel Dashboard > Storage > Blob create karen, token yahan aa jaye ga.
# Hostinger (Node.js hosting) pe isay khali chhor den — images public/uploads mein save hongi.
BLOB_READ_WRITE_TOKEN=""

# Hostinger pe (Blob ke baghair) uploads kis folder mein save hon — deploy folder se BAHAR ho.
# Misal: /home/u123456789/pkee-uploads   (khali chhorein to project ke andar "uploads" folder)
UPLOAD_DIR=""
